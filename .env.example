# ==============================================================================
# Gardoon Ltd. — Enterprise Multi-Agent Showcase Configuration
# Copy to .env and set your credentials (never commit .env to version control)
# ==============================================================================

# LLM Provider (Google Gemini / Vertex-compatible via LangChain)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Vector Database (Qdrant — leave empty for embedded mode, set URL in Docker/K8s)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tradingtackle_enterprise_kb

# LangGraph Persistence (PostgreSQL in production, falls back to MemorySaver in dev/tests)
POSTGRES_DSN=postgresql://gardoon:gardoon_showcase_pw@postgres:5432/agent_checkpoints

# Runtime & Kubernetes Metadata (injected automatically via Downward API in K8s)
APP_ENV=production
K8S_NAMESPACE=gardoon-ai-prod
K8S_POD_NAME=agent-orchestrator-local
K8S_NODE_NAME=eu-central-worker-01
CLUSTER_TOPOLOGY=docker-shared-net

# Public Guardrails & Abuse Protection
RATE_LIMIT_MAX_REQUESTS_PER_HOUR=15
MAX_INPUT_CHARS=2400
MAX_CORRECTION_LOOPS=2
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://agents.gardoon.ltd,https://gardoon.ltd
